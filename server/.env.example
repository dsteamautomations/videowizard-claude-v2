# Copy to server/.env (git-ignored). Never commit real values.

# --- now (slices 1–2) ---
# Direct Postgres connection of the VideoBuilder project: Supabase → Project Settings → Database → connection string (session pooler)
VW2_DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Employee directory login (same values as v1's .env)
VW2_SHARED_SUPABASE_URL=https://xxxx.supabase.co
VW2_SHARED_SUPABASE_SERVICE_KEY=sb_secret_...
VW2_APP_ID=
# Public origin operators open for /connect and /runs
VW2_APP_ORIGIN=http://localhost:8002
VW2_SESSION_HOURS=168
VW2_DEFAULT_PROCEDURE_VERSION=1

# --- voice + media slice ---
VW2_STORAGE_SUPABASE_URL=https://xxxx.supabase.co
VW2_STORAGE_SUPABASE_SERVICE_KEY=sb_secret_...
VW2_STORAGE_BUCKET=videowizard-v2
VW2_ELEVENLABS_API_KEY=

# --- analysis + planning slice ---
VW2_GEMINI_API_KEY=

# --- visuals slice ---
VW2_OPENAI_API_KEY=
VW2_HF_API_KEY=
